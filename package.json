{
  "name": "strapi-plugin-mega-nav",
  "version": "0.1.2",
  "description": "Smart navigation for Strapi — a visual mega-menu editor with true internal links, restart-free field config, native i18n, and a built-in importer for strapi-plugin-navigation data.",
  "keywords": [
    "strapi",
    "plugin",
    "navigation",
    "menu",
    "mega-menu"
  ],
  "license": "MIT",
  "author": "Paul Lefizelier",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paullefizelier/strapi-plugin-mega-nav.git"
  },
  "homepage": "https://github.com/paullefizelier/strapi-plugin-mega-nav#readme",
  "bugs": {
    "url": "https://github.com/paullefizelier/strapi-plugin-mega-nav/issues"
  },
  "type": "commonjs",
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "types": "./dist/admin/src/index.d.ts",
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "types": "./dist/server/src/index.d.ts",
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "strapi-plugin build",
    "watch": "strapi-plugin watch",
    "verify": "strapi-plugin verify",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0"
  },
  "devDependencies": {
    "@strapi/design-system": "^2.0.0-rc.29",
    "@strapi/icons": "^2.0.0-rc.29",
    "@strapi/sdk-plugin": "^5.3.2",
    "@strapi/strapi": "^5.0.0",
    "@strapi/typescript-utils": "^5.0.0",
    "@strapi/utils": "^5.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "styled-components": "^6.1.11",
    "typescript": "^5.5.4",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "@strapi/design-system": "^2.0.0-rc.29",
    "@strapi/icons": "^2.0.0-rc.29",
    "@strapi/strapi": "^5.0.0",
    "@strapi/utils": "^5.0.0",
    "react": "^17.0.0 || ^18.0.0",
    "react-dom": "^17.0.0 || ^18.0.0",
    "styled-components": "^6.0.0"
  },
  "strapi": {
    "kind": "plugin",
    "name": "mega-nav",
    "displayName": "Mega Nav",
    "description": "Visual mega-menu editor with true internal links, restart-free config and native i18n."
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
